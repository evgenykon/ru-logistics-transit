model Vehicle {
  id         String   @id @default(cuid())
  brand       String
  model       String
  licensePlate String @unique @map("license_plate")
  vin        String?  @unique
  year       Int?
  capacity   Float?
  volume     Float?
  bodyType   String?  @map("body_type")
  status     String   @default("active")
  lat        Float?
  lng        Float?
  axles      Int?
  bodyLength Float?   @map("body_length")
  bodyWidth  Float?   @map("body_width")
  bodyHeight Float?   @map("body_height")
  tentHeight Float?   @map("tent_height")
  trailerType String? @map("trailer_type")
  notes      String?
  organizationId String? @map("organization_id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vehicles")
}
