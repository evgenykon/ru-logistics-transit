enum OrderStatus {
  draft
  active
  completed
  cancelled

  @@map("order_status")
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  status          OrderStatus @default(draft)
  description     String?
  loadingDate     DateTime?   @map("loading_date")
  loadingTimeOfDay String?    @map("loading_time_of_day")
  useLocalTime    Boolean     @default(false) @map("use_local_time")
  timezone        String?     @default("+3")
  expectedCompletionDate DateTime? @map("expected_completion_date")
  organizationId  String?     @map("organization_id")
  createdById     String?     @map("created_by_id")
  vehicleId       String?     @map("vehicle_id")
  counterpartyId  String?     @map("counterparty_id")
  cargos          Cargo[]
  orderWarehouses OrderWarehouse[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model OrderWarehouse {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  warehouseId String   @map("warehouse_id")
  type        String   @default("origin")
  loadingDate   DateTime? @map("loading_date")
  loadingTime   String?   @map("loading_time")
  unloadingDate DateTime? @map("unloading_date")
  unloadingTime String?   @map("unloading_time")
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_warehouses")
}

model Cargo {
  id       String  @id @default(cuid())
  name     String
  weight   Float?
  volume   Float?
  quantity Int     @default(1)
  unit     String  @default("шт")
  orderId  String? @map("order_id")
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("cargos")
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  type        String
  description String
  userId      String?  @map("user_id")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("order_events")
}
